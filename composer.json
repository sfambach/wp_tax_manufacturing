{
    "name": "sfambach/wp-tax-manufacturing",
    "description": "Taxmod Manufacturing — build orders and build status on top of the Taxonomy Modeller and Taxmod Stock.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "TaxmodManufacturing\\Core\\": "src/Core/",
            "TaxmodManufacturing\\WordPress\\": "src/WordPress/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload-dev": {
        "psr-4": {
            "TaxmodManufacturing\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
